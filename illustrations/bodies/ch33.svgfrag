  <path d="M 300 270 l 0 40 q 0 12 12 12" fill="none" stroke="#9AA5B1" stroke-width="6"/>
  <text x="310" y="330" text-anchor="middle" font-family="sans-serif" font-size="13" fill="#FFF8EC">opens panel</text>
  <circle cx="420" cy="290" r="18" fill="none" stroke="#E4572E" stroke-width="6"/>
  <text x="420" y="330" text-anchor="middle" font-family="sans-serif" font-size="13" fill="#FFF8EC">starts trail</text>
  <circle cx="520" cy="290" r="16" fill="#E9C46A"/>
  <circle cx="520" cy="290" r="4" fill="#2B2B2B"/>
